{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "nodeVersion": "22.17.1",
  "headers": [
    {
      "source": "/assets/items/*.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=14400" }]
    },
    {
      "source": "/assets/traits/*.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=14400" }]
    },
    {
      "source": "/assets/datatft/*-portrait.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=14400" }]
    },
    {
      "source": "/assets/augment-icons/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=14400" }]
    }
  ]
}
