# Your own fixed access code, 16 to 256 characters.
OWNER_ACCESS_CODE=
# Set the exact origin separately for production and preview.
SITE_ORIGIN=http://127.0.0.1:3000

# Local sample. Use your own hosted HTTPS/libSQL database on EdgeOne.
DATABASE_URL=file:./.local/tft.db
DATABASE_AUTH_TOKEN=

# Local media sample. Omit MEDIA_DIRECTORY and set EDGEONE_BLOB_STORE on EdgeOne.
MEDIA_DIRECTORY=.local/media
EDGEONE_BLOB_STORE=
# First import from this computer only. Leave these unset on EdgeOne.
EDGEONE_BLOB_PROJECT_ID=
EDGEONE_BLOB_TOKEN=
# Optional private S3-compatible media store.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PATH_STYLE=true

# Optional owner-side Feishu integration.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOCUMENT_ID=
FEISHU_WRITEBACK_ENABLED=false
